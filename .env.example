# Copy to .env and fill in. Never commit .env.

# --- LLM provider (pluggable) ---
# LLM_PROVIDER: auto | openai | anthropic | gemini | openrouter | local | none
#   auto = detect from whichever key is present (Anthropic -> Gemini -> OpenAI), else none.
LLM_PROVIDER=auto

# Generic key / base URL / model overrides (optional; provider keys below take precedence)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_CLASSIFY_MODEL=

# Provider-specific keys (set one, or use LLM_API_KEY)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Delivery: slack | email | both | none ---
DELIVERY=none

# Slack (if DELIVERY is slack or both)
SLACK_WEBHOOK_URL=

# Email / SMTP (if DELIVERY is email or both)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_RECIPIENTS=

# --- Schedule / timezone (informational; n8n owns the actual schedule) ---
TIMEZONE=America/New_York

# --- SEC EDGAR identity (required User-Agent; use your name + email) ---
EDGAR_IDENTITY=Your Name your.email@example.com
