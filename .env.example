# Copy to .env and fill in. Never commit .env.

# --- LLM (required for the "why it matters" judgment) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# --- Delivery: slack | email | both | none ---
DELIVERY=none

# Slack (if DELIVERY is slack or both)
SLACK_WEBHOOK_URL=

# Email / SMTP (if DELIVERY is email or both)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_RECIPIENTS=

# --- Schedule / timezone (informational; n8n owns the actual schedule) ---
TIMEZONE=America/New_York

# --- SEC EDGAR identity (required User-Agent; use your name + email) ---
EDGAR_IDENTITY=Your Name your.email@example.com
