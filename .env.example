# Copy to .env locally. The collectors and dashboard work without an LLM or delivery key.

# LLM_PROVIDER: none | auto | openai | anthropic | gemini | openrouter | local | lmstudio
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Use a real organization/contact for automatic EDGAR collection.
EDGAR_IDENTITY=Your Name your.email@example.com

# Yahoo is a no-key demo provider. Configure Alpaca feeds only with eligible credentials.
MARKET_PROVIDER=yahoo
MARKET_FALLBACK=none
ALPACA_FEED=sip
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Delivery: none | slack | email | both. Partial coverage is disclosed by default.
DELIVERY=none
REQUIRE_COMPLETE=false
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_RECIPIENTS=

# Cutoff and scheduler clock. Timezone must be an IANA name, cutoff earlier than 08:00.
TIMEZONE=America/New_York
BRIEFING_TIME=07:45

# Optional absolute overrides. Runtime archive defaults to var/archive.
# ARCHIVE_DIR=
# PROFILE_FILE=
# COVERAGE_FILE=
# DASHBOARD_SECRET_KEY=

# Optional phone alerts via ntfy (https://ntfy.sh). Schedule `python run.py --alerts` every 15 minutes;
# each alert is pushed once per day. Use a hard-to-guess topic name: anyone who knows it can read it.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
